{
  "version": "1.0.0",
  "metadata": {
    "name": "id_duplicado",
    "description": "Dois servidores MCP com o mesmo identificador"
  },
  "guardrails": {
    "enable_pii_redaction": true,
    "entities": ["PERSON"],
    "mask_token": "[REDACTED]"
  },
  "schemas": {
    "SaidaSimples": {
      "description": "Saída simples",
      "fields": {
        "texto": {
          "type": "str",
          "description": "Texto de saída"
        }
      }
    }
  },
  "mcp_servers": [
    {
      "id": "busca_duplicada",
      "transport": "sse",
      "url": "http://mcp-busca-a:9501/sse",
      "timeout": 30
    },
    {
      "id": "busca_duplicada",
      "transport": "sse",
      "url": "http://mcp-busca-b:9502/sse",
      "timeout": 30
    }
  ],
  "openapi_services": [],
  "orchestration": {
    "type": "sequential",
    "name": "pipeline_id_duplicado",
    "input_volume_path": "/app/inputs",
    "agents": [
      {
        "name": "agente_unico",
        "model": "gemini-2.5-flash",
        "instruction": "Responda SOMENTE com JSON válido conforme o schema SaidaSimples.",
        "output_key": "saida",
        "output_schema_ref": "SaidaSimples"
      }
    ]
  }
}
