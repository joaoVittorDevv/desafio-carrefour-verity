{
  "version": "1.0.0",
  "metadata": {
    "name": "identificador_invalido",
    "description": "orchestration.name com hífen, que não é um identificador Python válido"
  },
  "guardrails": {
    "enable_pii_redaction": true,
    "entities": ["PERSON"],
    "mask_token": "[REDACTED]"
  },
  "schemas": {
    "SaidaSimples": {
      "description": "Saída simples",
      "fields": {
        "texto": {
          "type": "str",
          "description": "Texto de saída"
        }
      }
    }
  },
  "mcp_servers": [],
  "openapi_services": [],
  "orchestration": {
    "type": "sequential",
    "name": "pipeline-com-hifen",
    "input_volume_path": "/app/inputs",
    "agents": [
      {
        "name": "agente_unico",
        "model": "gemini-2.5-flash",
        "instruction": "Responda SOMENTE com JSON válido conforme o schema SaidaSimples.",
        "output_key": "saida",
        "output_schema_ref": "SaidaSimples"
      }
    ]
  }
}
