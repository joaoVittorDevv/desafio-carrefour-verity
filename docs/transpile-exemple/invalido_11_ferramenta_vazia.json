{
  "version": "1.0.0",
  "metadata": {
    "name": "ferramenta_vazia",
    "description": "Binding MCP com identificador de ferramenta em branco"
  },
  "guardrails": {
    "enable_pii_redaction": true,
    "entities": ["PERSON"],
    "mask_token": "[REDACTED]"
  },
  "schemas": {
    "SaidaBusca": {
      "description": "Resultado de busca",
      "fields": {
        "resultado": {
          "type": "str",
          "description": "Conteúdo recuperado"
        }
      }
    }
  },
  "mcp_servers": [
    {
      "id": "busca_interna",
      "transport": "sse",
      "url": "http://mcp-busca:9601/sse",
      "timeout": 30
    }
  ],
  "openapi_services": [],
  "orchestration": {
    "type": "sequential",
    "name": "pipeline_ferramenta_vazia",
    "input_volume_path": "/app/inputs",
    "agents": [
      {
        "name": "buscador",
        "model": "gemini-2.5-flash",
        "instruction": "Responda SOMENTE com JSON válido conforme o schema SaidaBusca.",
        "mcp_bindings": [
          {
            "server_id": "busca_interna",
            "allowed_tools": [" "]
          }
        ],
        "output_key": "resultado_busca",
        "output_schema_ref": "SaidaBusca"
      }
    ]
  }
}
