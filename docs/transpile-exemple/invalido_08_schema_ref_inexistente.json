{
  "version": "1.0.0",
  "metadata": {
    "name": "schema_ref_inexistente",
    "description": "Agente referencia um output_schema_ref que não existe na seção schemas"
  },
  "guardrails": {
    "enable_pii_redaction": true,
    "entities": ["PERSON"],
    "mask_token": "[REDACTED]"
  },
  "schemas": {
    "SaidaReal": {
      "description": "Schema existente",
      "fields": {
        "texto": {
          "type": "str",
          "description": "Texto de saída"
        }
      }
    }
  },
  "mcp_servers": [],
  "openapi_services": [],
  "orchestration": {
    "type": "sequential",
    "name": "pipeline_ref_quebrada",
    "input_volume_path": "/app/inputs",
    "agents": [
      {
        "name": "agente_unico",
        "model": "gemini-2.5-flash",
        "instruction": "Responda SOMENTE com JSON válido conforme o schema SaidaReal.",
        "output_key": "saida",
        "output_schema_ref": "SaidaFantasma"
      }
    ]
  }
}
