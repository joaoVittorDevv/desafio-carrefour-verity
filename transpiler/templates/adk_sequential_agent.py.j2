{% set booking = spec.orchestration.agents[-1] %}
def _validate_output(key):
    def callback(callback_context):
{% if 'create_exam_appointment' in (booking.openapi_bindings | map(attribute='allowed_operations') | sum(start=[])) and 'scheduled_exams' in spec.schemas[booking.output_schema_ref].fields %}
        if key == {{ booking.output_key | pyrepr }}:
            # A verified POST is the registration evidence itself; the final LLM text is
            # never parsed, so transcription drift cannot fail an already committed POST.
            verified = callback_context.state.get('_booking_verified')
            if not isinstance(verified, dict):
                raise AgentPipelineExecutionError("Booking output lacks verified API response")
            try:
                result = OUTPUT_SCHEMAS[key].model_validate(verified)
            except (ValidationError, ValueError, TypeError):
                raise AgentPipelineExecutionError(
                    "Booking output lacks verified API response") from None
            # Byte-identical dump of the raw evidence keeps the CLI confirmation equality intact.
            callback_context.state[key] = result.model_dump(mode="json")
            return None
{% endif %}
        value = callback_context.state.get(key)
        try:
            schema = OUTPUT_SCHEMAS[key]
            if isinstance(value, str):
                # LLMs routinely wrap JSON in markdown fences; strip that noise only.
                value = re.sub(r"^```[a-zA-Z]*\s*|\s*```$", "", value.strip())
                value = json.loads(value)
            if (isinstance(value, dict) and len(value) == 1
                    and next(iter(value)).endswith("_response")
                    and isinstance(value[next(iter(value))], dict)):
                # OpenAPIToolset advertises the payload under an "<operation>_response" wrapper.
                value = value[next(iter(value))]
            result = schema.model_validate_json(value) if isinstance(value, str) else schema.model_validate(value)
        except (ValidationError, ValueError, TypeError):
            raise AgentPipelineExecutionError(f"Invalid output at {key}; no registration confirmed") from None
        output = result.model_dump(mode="json")
{% set first = spec.orchestration.agents[0] %}
{% if 'extract_and_anonymize_medical_order' in (first.mcp_bindings | map(attribute='allowed_tools') | sum(start=[])) and 'exams' in spec.schemas[first.output_schema_ref].fields %}
        if key == {{ first.output_key | pyrepr }}:
            evidence = callback_context.state.get('_ocr_verified')
            if (not evidence or not output.get('exams') or
                    output.get('sanitized_text') != evidence['sanitized_text'] or
                    output.get('pii_entities_masked') != evidence['pii_entities_masked']):
                raise AgentPipelineExecutionError("OCR output lacks verified tool evidence")
            numbered = re.findall(r"(?m)^\s*\d+[.)]\s*([^\n]+?)\s*$", evidence['sanitized_text'])
            if (not numbered or
                    [name.strip().casefold() for name in numbered] !=
                    [item['raw_name'].strip().casefold() for item in output['exams']] or
                    any(item['is_handwritten_hint'] for item in output['exams']) or
                    re.search(r"(?m)^\s*\+", evidence['sanitized_text'])):
                raise AgentPipelineExecutionError("OCR exam lines differ from extracted exams")
{% endif %}
{% if spec.orchestration.agents | length > 1 %}
{% set lookup = spec.orchestration.agents[-2] %}
{% if 'search_exam_catalog_hybrid' in (lookup.mcp_bindings | map(attribute='allowed_tools') | sum(start=[])) and 'matched_exams' in spec.schemas[lookup.output_schema_ref].fields %}
        if key == {{ lookup.output_key | pyrepr }}:
            if output != callback_context.state.get('_rag_verified'):
                raise AgentPipelineExecutionError("RAG output lacks verified tool evidence")
            require_complete_order(callback_context.state.get({{ first.output_key | pyrepr }}), output)
{% endif %}
{% endif %}
        callback_context.state[key] = output
        return None

    return callback


def _validate_input(agent_name):
    """Typed input contract: validate the upstream payload before the LLM runs."""
    def callback(callback_context):
        raw = callback_context.state.get(INPUT_KEYS[agent_name])
        try:
            schema = INPUT_SCHEMAS[agent_name]
            if isinstance(raw, str):
                # Same markdown-fence stripping as _validate_output for LLM-wrapped JSON.
                raw = re.sub(r"^```[a-zA-Z]*\s*|\s*```$", "", raw.strip())
                result = schema.model_validate_json(raw)
            elif isinstance(raw, dict):
                result = schema.model_validate(raw)
            else:
                raise TypeError("missing upstream input")
        except (ValidationError, ValueError, TypeError):
            raise AgentPipelineExecutionError(f"Invalid input for {agent_name}; no registration confirmed") from None
        inspect_for_pii(result)
        normalized = result.model_dump(mode="json")
        if "exams" in normalized and not normalized["exams"]:
            raise AgentPipelineExecutionError(f"Invalid input for {agent_name}; no registration confirmed")
        if "matched_exams" in normalized:
            require_complete_order(callback_context.state.get({{ first.output_key | pyrepr }}), normalized)
            verified = callback_context.state.get("_rag_verified")
            if verified is None or normalized != verified:
                raise AgentPipelineExecutionError(
                    f"Invalid input for {agent_name}; differs from verified RAG evidence")
        callback_context.state[INPUT_KEYS[agent_name]] = normalized
        callback_context.state[f"temp:{agent_name}_input"] = normalized
        return None

    return callback


def build_pipeline():
    """Create toolsets at runtime, after preflight (never during import/transpilation)."""
    server_params = {
{% for server in spec.mcp_servers %}
        {{ server.id | pyrepr }}: SseConnectionParams(url={{ server.url | pyrepr }}, timeout={{ server.timeout }}),
{% endfor %}
    }
    service_specs = {}
{% for service in spec.openapi_services %}
    response = httpx.get({{ service.spec_url | pyrepr }}, timeout=10)
    response.raise_for_status()
    endpoint = urlsplit({{ service.spec_url | pyrepr }})
    service_spec = response.json()
    # FastAPI serves a relative "servers" URL; the toolset needs an absolute origin.
    service_spec.setdefault("servers", [{"url": f"{endpoint.scheme}://{endpoint.netloc}"}])
    service_specs[{{ service.id | pyrepr }}] = service_spec
{% endfor %}
    agents = []
{% for agent in spec.orchestration.agents %}
{% set is_booking = 'create_exam_appointment' in (agent.openapi_bindings | map(attribute='allowed_operations') | sum(start=[])) %}
    agents.append(LlmAgent(
        name={{ agent.name | pyrepr }},
        model={{ agent.model | pyrepr }},
        instruction={{ agent.instruction | pyrepr }},
        output_key={{ agent.output_key | pyrepr }},
{% if is_booking %}
        # No output_schema kwarg: the ADK validates the final LLM text against it mid-stream and a
        # flaky model echo aborts the turn; the booking contract is the verified tool evidence instead.
{% else %}
        output_schema={{ agent.output_schema_ref }},
{% endif %}
        include_contents={{ agent.include_contents | pyrepr }},
        tools=[
{% for binding in agent.mcp_bindings %}
            MCPToolset(connection_params=server_params[{{ binding.server_id | pyrepr }}], tool_filter={{ binding.allowed_tools | pyrepr }}),
{% endfor %}
{% for binding in agent.openapi_bindings %}
            OpenAPIToolset(spec_dict=service_specs[{{ binding.service_id | pyrepr }}], tool_filter={{ binding.allowed_operations | pyrepr }}, allow_private_network_access=True),
{% endfor %}
        ],
        before_model_callback=before_model_callback,
        before_tool_callback=before_tool_callback,
        after_tool_callback=after_tool_callback,
        after_agent_callback=_validate_output({{ agent.output_key | pyrepr }}),
{% if agent.input_schema_ref %}
        before_agent_callback=_validate_input({{ agent.name | pyrepr }}),
{% endif %}
    ))
{% endfor %}
    return SequentialAgent(name={{ spec.orchestration.name | pyrepr }}, sub_agents=agents)
